PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=blogdb
DB_USER=root
DB_PASSWORD=

# any long random string - sign your tokens with your own, never this file's
SECRET_KEY=

# set to false once the tables are settled, to stop sequelize altering them on boot
DB_SYNC=true

# the frontend's origin, allowed to call this API (CORS). Adjust if your
# Next.js dev server runs on a different port
FRONTEND_URL=http://localhost:3000
